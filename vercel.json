{
  "redirects": [
    { "source": "/fr/comment-postuler.html", "destination": "/fr/comment-faire-la-demande.html", "permanent": true },
    { "source": "/fr/delai-de-traitement.html", "destination": "/fr/delais-de-traitement.html", "permanent": true },
    { "source": "/fr/politique-confidentialite.html", "destination": "/fr/politique-de-confidentialite.html", "permanent": true },
    { "source": "/fr/index.html", "destination": "/fr/", "permanent": true },
    { "source": "/en/index.html", "destination": "/en/", "permanent": true },
    { "source": "/de/index.html", "destination": "/de/", "permanent": true },
    { "source": "/es/index.html", "destination": "/es/", "permanent": true },
    { "source": "/pt/index.html", "destination": "/pt/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}

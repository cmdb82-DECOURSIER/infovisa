{
  "name": "visa-comparator",
  "version": "1.0.0",
  "description": "Global visa requirements comparator",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "db:setup": "prisma migrate deploy",
